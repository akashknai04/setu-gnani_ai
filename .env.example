# Copy to .env and fill in. NEVER commit .env.

# ---- Mode ----
# 1 = fake STT (reads sidecar .txt) + fake TTS (silent WAV). No keys, no network.
MOCK_VOICE=1

# ---- Gnani API (https://docs.gnani.ai) ----
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Prisma STT (REST, confirmed in docs: POST /stt/v3, multipart, header X-API-Key-ID)
PRISMA_PATH=/stt/v3
PRISMA_MODEL=prisma-v3.0
# prisma-v3.0 accepts indic-auto or a comma list of up to 4 codes (confirmed)
PRISMA_LANGUAGE_CODE=hi-IN,kn-IN,en-IN
# verbatim | transcribe | codemix (codemix is prisma-v3.0 only, confirmed)
PRISMA_FORMAT=codemix
PRISMA_USE_KEYTERMS=1
PRISMA_TIMEOUT_S=15

# Timbre TTS (REST, confirmed: POST /api/v1/tts/inference, JSON, header X-API-Key-ID)
TIMBRE_PATH=/api/v1/tts/inference
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE_HI=Nalini
TIMBRE_VOICE_KN=Saanvi
TIMBRE_VOICE_EN=Kaveri
# Rider voices, used only when the call screen plays a scenario for a solo demo
TIMBRE_RIDER_VOICE_HI=Deepak
TIMBRE_RIDER_VOICE_KN=Kavin
TIMBRE_RIDER_VOICE_EN=Pranav
TIMBRE_SAMPLE_RATE=16000
TIMBRE_TIMEOUT_S=20

# Evon (LLM classifier only). off | api | local
# Docs: Evon v3.3 is NOT on the hosted API platform; open weights only.
# local = an OpenAI-compatible chat endpoint you run yourself (vLLM / llama.cpp server).
EVON_MODE=off
EVON_LOCAL_URL=http://127.0.0.1:8001/v1/chat/completions
EVON_MODEL_NAME=gnani/gnani-evon-v3.3-30B-A3B
EVON_TIMEOUT_S=4

# ---- Real phone call through Gnani Inya (docs/phone_call.md) ----
# Inya platform key (app.gnani.ai -> API Keys, needs the "agents" permission). May differ from GNANI_API_KEY.
INYA_API_KEY=
INYA_BASE_URL=https://api.inya.ai/platform/v1
# Filled in after  python call_me.py setup  creates the agent
INYA_BOT_ID=
INYA_ENVIRONMENT=development
# Any long random text. Gnani sends it back on every turn so nobody else can drive your agent.
INYA_BRIDGE_TOKEN=
# Order the phone call is about: ORD_1024 (handover can be approved) or ORD_2048 (needs OTP, never handed over)
INYA_ORDER_ID=ORD_1024
# Seconds the line is held while Asha decides on her phone (keep below the action timeout in the dashboard)
INYA_WAIT_S=25
# The rider's phone (yours). Must be whitelisted in Gnani: Phone Numbers -> Whitelisted.
CALL_TO_NUMBER=
CALL_COUNTRY_CODE=+91

# ---- Live translation: rider <-> customer (SETU AI interpreter) ----
# phrases | model | both. "model" parts need:  pip install -r requirements-translate.txt
TRANSLATE_MODE=both
# Seconds the customer's phone rings before SETU's AI agent answers instead
INTERPRET_RING_S=20

# ---- App ----
APPROVAL_SECRET=change-me-to-a-long-random-string
APPROVAL_TTL_S=30
DB_PATH=data/deliverysaathi.db
PHRASE_CACHE_DIR=data/phrase_cache
